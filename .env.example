# OpenAI API key for the AI chat assistant (server-side)
#
# LOCAL DEV:  copy this file to `.env` and set OPENAI_API_KEY.
#             `npm run dev` serves /api/chat via the Vite dev middleware.
#
# CLOUDFLARE PAGES: set OPENAI_API_KEY (and optionally OPENAI_MODEL)
#             in Cloudflare Dashboard > your Pages project > Settings >
#             Environment variables (Settings > Bindings on Pages "Functions").
OPENAI_API_KEY=

# Optional: override the model (defaults to gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini